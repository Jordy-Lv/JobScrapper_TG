{
  "manifest_version": 3,
  "name": "__MSG_nombre__",
  "short_name": "__MSG_nombre_corto__",
  "version": "1.0.0",
  "default_locale": "es",
  "description": "__MSG_descripcion__",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://*.computrabajo.com/*",
    "https://*.magneto365.com/*",
    "https://postulador.tailf6cdf1.ts.net/*"
  ],
  "optional_host_permissions": [
    "https://*.ts.net/*"
  ],
  "background": {
    "service_worker": "servicio.js",
    "type": "module"
  },
  "action": {
    "default_title": "Asistente de postulación",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "iconos/16.png",
      "32": "iconos/32.png",
      "48": "iconos/48.png",
      "128": "iconos/128.png"
    }
  },
  "options_page": "opciones.html",
  "icons": {
    "16": "iconos/16.png",
    "32": "iconos/32.png",
    "48": "iconos/48.png",
    "128": "iconos/128.png"
  },
  "homepage_url": "https://postulador.tailf6cdf1.ts.net/api/v1/privacidad"
}
