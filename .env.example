# Copiar a .env y dar permisos solo al propietario: chmod 600 .env
# Nunca subir .env a git.

# Token del bot de Telegram (el bot de Hermes). Si se deja vacío, se lee
# desde la configuración de Hermes indicada en config.yaml (telegram.token_hermes).
TELEGRAM_BOT_TOKEN=

# Canal real de vacantes y chat de prueba (ids numéricos de Telegram)
TELEGRAM_CHAT_ID=-1004429829042
TELEGRAM_CHAT_PRUEBA=

# API de DeepSeek (clasificador, reportero y resumen)
DEEPSEEK_API_KEY=

# URL del check de healthchecks.io (https://hc-ping.com/<uuid>)
HEALTHCHECK_URL=
