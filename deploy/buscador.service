[Unit]
Description=Buscador de vacantes TI → Telegram (una corrida)

[Service]
Type=oneshot
WorkingDirectory=%h/buscador-vacantes
ExecStart=%h/.local/bin/uv run --frozen buscador.py
# Respaldo del límite interno de la corrida (operacion.timeout_corrida_min)
TimeoutStartSec=25min
Nice=10
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=buscador
